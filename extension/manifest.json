{
  "manifest_version": 3,
  "name": "Full Names for Productive",
  "short_name": "Full Names",
  "version": "1.0.0",
  "description": "Hover over a cut-off name (…) in Productive.io to see the full project, budget or service name.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.productive.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
